# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# connection_limit is not cosmetic — token-grant.processor.ts's
# concurrency=10 and content-sync.processor.ts's concurrency=2 are
# both sized against this number (see those files' docstrings).
# Changing it without updating those comments (and infra/docker-compose.yml's
# per-service values, which must sum to something Postgres's own
# max_connections can actually serve) will silently invalidate the
# reasoning behind those concurrency settings.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anime_platform?connection_limit=20&pool_timeout=10"

# ------------------------------------------------------------
# REDIS (BullMQ + leaderboards + cache)
# ------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ------------------------------------------------------------
# CONTENT SOURCE APIS
# ------------------------------------------------------------
# Jikan and AniList need no key for public data.
TMDB_API_KEY=""
# !!! Do not go live with ads/monetization on TMDB data until the
# commercial agreement is confirmed in writing — see
# tmdb.service.ts TMDB_COMMERCIAL_AGREEMENT_CONFIRMED and
# docs/TOS-COMPLIANCE.md

# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET=""
# Comma-separated list of your real frontend origin(s), e.g.
# "https://jtiverse.com,https://www.jtiverse.com". Required per
# Clerk's own security guidance — see clerk-auth.guard.ts's docstring
# for what an empty value here actually means (no azp check at all).
CLERK_AUTHORIZED_PARTIES=""
JWT_SECRET=""

# ------------------------------------------------------------
# COMMENT MODERATION
# ------------------------------------------------------------
# See comment-moderation.service.ts — fails CLOSED (comments held as
# FLAGGED) if this is unset, on purpose.
OPENAI_API_KEY=""

# ------------------------------------------------------------
# WEB APP ORIGIN
# ------------------------------------------------------------
# Read by both main.ts's CORS config and rooms.gateway.ts's Socket.IO
# CORS config — keep these in lockstep, see rooms.gateway.ts's
# docstring.
WEB_APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# OBJECT STORAGE (avatars, uploads)
# ------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ------------------------------------------------------------
# SEARCH
# ------------------------------------------------------------
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="local_dev_only_key_change_me"

# ------------------------------------------------------------
# ADS
# ------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
